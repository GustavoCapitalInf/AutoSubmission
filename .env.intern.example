# Intern-testing host configuration. Copy to a gitignored `.env` and fill in
# real values there — this file is committed and must never carry one.
#
#   cp .env.intern.example .env
#   docker compose up --build
#
# Then share http://<host>:5000 with the password below. HTTP Basic username
# defaults to `intern`.

WEBAPP_AUTH_USER=intern
WEBAPP_AUTH_PASSWORD=change-me-before-sharing

# Optional. Default 5000.
# WEBAPP_PORT=5000

# The app uses no model: native text + local Tesseract only.

# The command-line tools and the tests read statements from here; the web app
# does not. Set it in the shell: pytest never reads .env (README.md).
# BANK_STATEMENTS_DIR="/absolute/path/to/Bank Statements"
