# Intern-testing host configuration. Copy to a gitignored `.env` and fill in
# real values there — this file is committed and must never carry one.
#
#   cp .env.intern.example .env
#   docker compose up --build
#
# Then share http://<host>:5000 with the password below. HTTP Basic username
# defaults to `intern`.

WEBAPP_AUTH_USER=intern
WEBAPP_AUTH_PASSWORD=change-me-before-sharing

# Optional. Native-text statements of supported banks parse without this.
# Unknown layouts fall through to Gemini only when a key is present.
# GEMINI_API_KEY=

# Optional. Default 5000.
# WEBAPP_PORT=5000

# Do not set OCR_REMOTE_OPT_IN or PADDLE_REMOTE_OPT_IN on the intern stack.
# Intern testing stays offline-first (native text + local Tesseract).
