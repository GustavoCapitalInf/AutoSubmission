# Phase 3.1. Copy selectively into private runtime configuration.
# Start dormant; forced requests still select the pair and encounter its fence.
OCR_ALLOW_VISUAL_PAIR=0
OCR_VISUAL_PAIR_FALLBACK_TRIGGER=narrow
OCR_VISUAL_PAIR_LEGACY_VISUAL=0

# Loopback transports may be SSH tunnels. They never imply local execution.
VISUAL_PAIR_PROPOSER_URL=http://127.0.0.1:18013/v1
VISUAL_PAIR_REVIEWER_URL=http://127.0.0.1:18022/v1
VISUAL_PAIR_EXECUTION_CLASS=remote_paid
VISUAL_PAIR_TIMEOUT=900
VISUAL_PAIR_REVIEW_POLICY=always_review

# Evidence defaults to ~/.local/share/bank-statement-analysis/phase31-private.
# Optional override: an absolute path outside this checkout. Relative paths and
# paths resolving into this checkout (including symlinks) are refused.
# VISUAL_PAIR_PRIVATE_ROOT=/absolute/external/private-artifacts
# Webapp uploads, cached extraction and audit state default to that root's
# webapp_data child. WEBAPP_DATA_DIR overrides must also be absolute/external.

# Deliberately absent: VISUAL_PAIR_REMOTE_CUSTOMER_DATA_OPT_IN.
# A bounded evaluation may additionally set
# VISUAL_PAIR_CUSTOMER_DOCUMENT_SHA256_ALLOWLIST to comma-separated SHA256s.
# Only those exact PDF bytes are then authorized, including on cache hits.
# An explicitly empty/malformed list is an error, never unrestricted access.
# Customer authorization and publication policy require Gustavo's separate ruling.
# No host address, private key, or credential belongs in this file.
