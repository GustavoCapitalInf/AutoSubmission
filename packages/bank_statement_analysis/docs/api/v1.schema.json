{
  "$defs": {
    "AnalysedDocument": {
      "additionalProperties": false,
      "properties": {
        "accounts": {
          "description": "Each account, in printed order (a statement-wide exclusion first).",
          "items": {
            "discriminator": {
              "mapping": {
                "excluded": "#/$defs/ExcludedAccount",
                "included": "#/$defs/IncludedAccount"
              },
              "propertyName": "status"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/IncludedAccount"
              },
              {
                "$ref": "#/$defs/ExcludedAccount"
              }
            ]
          },
          "minItems": 1,
          "title": "Accounts",
          "type": "array",
          "x-source": "documents[], excluded_accounts[]"
        },
        "document_id": {
          "description": "The statement's id within the package.",
          "title": "Document Id",
          "type": "string",
          "x-source": "job.id"
        },
        "filename": {
          "description": "The file's name as submitted.",
          "title": "Filename",
          "type": "string",
          "x-source": "job.filename"
        },
        "sha256": {
          "description": "Lowercase hex SHA-256 of the PDF bytes.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string",
          "x-source": "job.content_sha256"
        },
        "status": {
          "const": "analysed",
          "description": "The statement was analysed; its accounts say which entered the figures.",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "filename",
        "sha256",
        "status",
        "accounts"
      ],
      "title": "AnalysedDocument",
      "type": "object"
    },
    "ApiError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "description": "What was refused; the error catalog gives each code's HTTP status.",
          "enum": [
            "no_statements",
            "too_many_statements",
            "invalid_filename",
            "statement_too_large",
            "not_a_pdf",
            "pdf_encrypted",
            "pdf_unreadable",
            "too_many_pages",
            "storage_full",
            "not_stored",
            "invalid_package_id",
            "invalid_request",
            "request_too_large",
            "package_conflict",
            "package_not_found",
            "route_not_found",
            "method_not_allowed",
            "unauthorized",
            "api_disabled",
            "storage_degraded",
            "internal_error"
          ],
          "title": "Code",
          "type": "string"
        },
        "filename": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The refused file's name, when one file was refused.",
          "title": "Filename"
        },
        "message": {
          "description": "The code's one fixed message; never statement content or exception text.",
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "filename"
      ],
      "title": "ApiError",
      "type": "object"
    },
    "DocumentProgress": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "description": "The statement's id within the package.",
          "title": "Document Id",
          "type": "string",
          "x-source": "job.id"
        },
        "filename": {
          "description": "The file's name as submitted.",
          "title": "Filename",
          "type": "string",
          "x-source": "job.filename"
        },
        "sha256": {
          "description": "Lowercase hex SHA-256 of the PDF bytes.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string",
          "x-source": "job.content_sha256"
        },
        "status": {
          "description": "`finished`: analysed, failed or interrupted; the ready package says which.",
          "enum": [
            "queued",
            "processing",
            "finished"
          ],
          "title": "Status",
          "type": "string",
          "x-source": "job.status"
        }
      },
      "required": [
        "document_id",
        "filename",
        "sha256",
        "status"
      ],
      "title": "DocumentProgress",
      "type": "object"
    },
    "DuplicateDocument": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "description": "The statement's id within the package.",
          "title": "Document Id",
          "type": "string",
          "x-source": "job.id"
        },
        "duplicate_of": {
          "description": "`document_id` of the statement kept in its place.",
          "title": "Duplicate Of",
          "type": "string",
          "x-source": "documents[].duplicate_of"
        },
        "filename": {
          "description": "The file's name as submitted.",
          "title": "Filename",
          "type": "string",
          "x-source": "job.filename"
        },
        "reason": {
          "description": "Why, in an open vocabulary: same_content, same_statement, superseded_long_printout, superseded_interim.",
          "title": "Reason",
          "type": "string",
          "x-source": "documents[].duplicate_reason"
        },
        "sha256": {
          "description": "Lowercase hex SHA-256 of the PDF bytes.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string",
          "x-source": "job.content_sha256"
        },
        "status": {
          "const": "duplicate",
          "description": "The statement repeats another of the package; nothing of it is counted.",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "filename",
        "sha256",
        "status",
        "duplicate_of",
        "reason"
      ],
      "title": "DuplicateDocument",
      "type": "object"
    },
    "ErrorResponse": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/ApiError",
          "description": "The refusal."
        }
      },
      "required": [
        "error"
      ],
      "title": "ErrorResponse",
      "type": "object"
    },
    "ExcludedAccount": {
      "additionalProperties": false,
      "properties": {
        "account_index": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "1-based place of the account in its statement; null when the whole statement is left out because its main account was not verified or printed no activity.",
          "title": "Account Index",
          "x-source": "excluded_accounts[].account_index"
        },
        "reason": {
          "description": "Why, in an open vocabulary: main_account_unverified, main_account_idle, document_transfer_pairing_ambiguous, document_omission_unratified, duplicate_statement, superseded_long_printout, superseded_interim, or the account's own outcome reason.",
          "title": "Reason",
          "type": "string",
          "x-source": "excluded_accounts[].reason"
        },
        "status": {
          "const": "excluded",
          "description": "An account left out of the package's figures.",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "account_index",
        "reason"
      ],
      "title": "ExcludedAccount",
      "type": "object"
    },
    "FailedDocument": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "description": "The statement's id within the package.",
          "title": "Document Id",
          "type": "string",
          "x-source": "job.id"
        },
        "failure": {
          "$ref": "#/$defs/Failure",
          "description": "Why.",
          "x-source": "job.status, job.analysis_error"
        },
        "filename": {
          "description": "The file's name as submitted.",
          "title": "Filename",
          "type": "string",
          "x-source": "job.filename"
        },
        "sha256": {
          "description": "Lowercase hex SHA-256 of the PDF bytes.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string",
          "x-source": "job.content_sha256"
        },
        "status": {
          "const": "failed",
          "description": "The statement has no analysis under the v1 reading; nothing of it is counted.",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "filename",
        "sha256",
        "status",
        "failure"
      ],
      "title": "FailedDocument",
      "type": "object"
    },
    "Failure": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "description": "Why the statement has no analysis under the v1 reading.",
          "enum": [
            "unreadable",
            "unsupported_statement",
            "analysis_failed",
            "processing_failed",
            "interrupted",
            "reading_unavailable"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "description": "The code's one fixed message.",
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Failure",
      "type": "object"
    },
    "Funder": {
      "additionalProperties": false,
      "properties": {
        "account_periods": {
          "description": "Account periods in which the funder was paid.",
          "minimum": 0,
          "title": "Account Periods",
          "type": "integer",
          "x-source": "funders[].documents"
        },
        "name": {
          "description": "The confirmed funder.",
          "title": "Name",
          "type": "string",
          "x-source": "funders[].funder"
        },
        "paid_cents": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Paid to the funder; null under a currency refusal.",
          "title": "Paid Cents",
          "x-source": "funders[].total_debited"
        },
        "payment_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Payments to the funder; null when no match counted them.",
          "title": "Payment Count",
          "x-source": "funders[].debit_count"
        },
        "returned_cents": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Returned unpaid; null under a currency refusal.",
          "title": "Returned Cents",
          "x-source": "funders[].returned_payment_total"
        },
        "returned_payment_count": {
          "description": "Payments to the funder returned unpaid.",
          "minimum": 0,
          "title": "Returned Payment Count",
          "type": "integer",
          "x-source": "funders[].returned_payment_count"
        }
      },
      "required": [
        "name",
        "account_periods",
        "payment_count",
        "paid_cents",
        "returned_payment_count",
        "returned_cents"
      ],
      "title": "Funder",
      "type": "object"
    },
    "IncludedAccount": {
      "additionalProperties": false,
      "description": "One account whose figures are in the package's. Every source is a key of the package's member row,\n`documents[]`.",
      "properties": {
        "account_index": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "1-based place of the account in a statement that prints several; null for a statement of one account.",
          "title": "Account Index",
          "x-source": "account_index"
        },
        "account_masked": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "`****` and the last four digits of the account number.",
          "title": "Account Masked",
          "x-source": "account, masked"
        },
        "active_positions": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Confirmed lenders' positions active in the period; null when not read.",
          "title": "Active Positions",
          "x-source": "active_positions"
        },
        "average_daily_balance_cents": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Average daily balance over every calendar day of the period; null unless the daily ledger is validated.",
          "title": "Average Daily Balance Cents",
          "x-source": "average_daily_balance"
        },
        "average_daily_balance_days": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Calendar days the average daily balance covers; null with it.",
          "title": "Average Daily Balance Days",
          "x-source": "adb_calendar_days, when adb_validated"
        },
        "bank": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The bank, as printed.",
          "title": "Bank",
          "x-source": "bank"
        },
        "closing_balance_cents": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Closing balance; null unless the statement reconciles.",
          "title": "Closing Balance Cents",
          "x-source": "ending_balance"
        },
        "corporate_use": {
          "description": "Whether the statement's figures can be used as they are.",
          "enum": [
            "approved",
            "summary_only",
            "manual_review_required"
          ],
          "title": "Corporate Use",
          "type": "string",
          "x-source": "corporate_use"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "ISO 4217 code of this account's money figures; null when the statement names none.",
          "title": "Currency",
          "x-source": "currency"
        },
        "deposit_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Number of the credits in `deposits_cents`; null when no count pairs with that total.",
          "title": "Deposit Count",
          "x-source": "deposit_count"
        },
        "deposits_cents": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Credits, less transfers between the statement's own accounts.",
          "title": "Deposits Cents",
          "x-source": "credits"
        },
        "held_for_review_cents": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Credits held for an analyst's review; null when revenue is not established.",
          "title": "Held For Review Cents",
          "x-source": "excluded_pending_review_total"
        },
        "integrity_risk": {
          "description": "Document integrity finding.",
          "enum": [
            "clear",
            "review",
            "high"
          ],
          "title": "Integrity Risk",
          "type": "string",
          "x-source": "integrity_risk"
        },
        "lender_payment_count": {
          "description": "Number of the payments in `lender_payments_cents`.",
          "minimum": 0,
          "title": "Lender Payment Count",
          "type": "integer",
          "x-source": "lender_debit_count"
        },
        "lender_payments_cents": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Payments to confirmed lenders.",
          "title": "Lender Payments Cents",
          "x-source": "lender_debits"
        },
        "negative_days": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Printed days that end below zero; null when the count is on another basis or not computable.",
          "title": "Negative Days",
          "x-source": "nsf_count, when nsf_source is negative_printed_days"
        },
        "non_revenue_cents": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Credits that are not revenue.",
          "title": "Non Revenue Cents",
          "x-source": "non_revenue_total"
        },
        "opening_balance_cents": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Opening balance.",
          "title": "Opening Balance Cents",
          "x-source": "beginning_balance"
        },
        "period_end": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Last day of the printed statement period.",
          "title": "Period End",
          "x-source": "period_end"
        },
        "period_start": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "First day of the printed statement period.",
          "title": "Period Start",
          "x-source": "period_start"
        },
        "possible_positions": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Potential lenders' positions active in the period; null when not read.",
          "title": "Possible Positions",
          "x-source": "possible_positions"
        },
        "quality": {
          "description": "How the statement's figures were established.",
          "enum": [
            "transaction_level",
            "summary_aggregate",
            "needs_review"
          ],
          "title": "Quality",
          "type": "string",
          "x-source": "quality"
        },
        "reconciles": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Whether the account's own figures reconcile to the bank's.",
          "title": "Reconciles",
          "x-source": "reconciles"
        },
        "returned_funder_payments_cents": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Funder payments returned unpaid.",
          "title": "Returned Funder Payments Cents",
          "x-source": "returned_funder_payment_total"
        },
        "revenue_review_required": {
          "description": "Whether the account's revenue needs an analyst's review.",
          "title": "Revenue Review Required",
          "type": "boolean",
          "x-source": "revenue_review_required"
        },
        "status": {
          "const": "included",
          "description": "An account whose figures are in the package's figures.",
          "title": "Status",
          "type": "string"
        },
        "true_revenue_cents": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "True revenue: verified plus counted credits; null when not established.",
          "title": "True Revenue Cents",
          "x-source": "true_revenue_total"
        },
        "true_revenue_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Number of the credits in True revenue.",
          "title": "True Revenue Count",
          "x-source": "true_revenue_count"
        },
        "withdrawals_cents": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Debits, less transfers between the statement's own accounts.",
          "title": "Withdrawals Cents",
          "x-source": "debits"
        },
        "withholding_rate_bps": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Lender payments (paid and returned) over the withholding basis; null when the basis publishes no rate.",
          "title": "Withholding Rate Bps",
          "x-source": "withholding_rate"
        }
      },
      "required": [
        "status",
        "account_index",
        "bank",
        "account_masked",
        "currency",
        "period_start",
        "period_end",
        "opening_balance_cents",
        "closing_balance_cents",
        "deposits_cents",
        "deposit_count",
        "withdrawals_cents",
        "true_revenue_cents",
        "true_revenue_count",
        "held_for_review_cents",
        "non_revenue_cents",
        "average_daily_balance_cents",
        "average_daily_balance_days",
        "negative_days",
        "lender_payments_cents",
        "lender_payment_count",
        "returned_funder_payments_cents",
        "active_positions",
        "possible_positions",
        "withholding_rate_bps",
        "quality",
        "corporate_use",
        "integrity_risk",
        "reconciles",
        "revenue_review_required"
      ],
      "title": "IncludedAccount",
      "type": "object"
    },
    "MonthPositions": {
      "additionalProperties": false,
      "properties": {
        "active_positions": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Confirmed lenders' positions active that month; null when not read.",
          "title": "Active Positions",
          "x-source": "active_positions_by_month[].active_positions"
        },
        "month": {
          "description": "A calendar month the statements stand for.",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
          "title": "Month",
          "type": "string",
          "x-source": "active_positions_by_month[].month"
        },
        "possible_positions": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Potential lenders' positions active that month; null when not read.",
          "title": "Possible Positions",
          "x-source": "active_positions_by_month[].possible_positions"
        }
      },
      "required": [
        "month",
        "active_positions",
        "possible_positions"
      ],
      "title": "MonthPositions",
      "type": "object"
    },
    "Package": {
      "discriminator": {
        "mapping": {
          "processing": "#/$defs/ProcessingPackage",
          "ready": "#/$defs/ReadyPackage"
        },
        "propertyName": "status"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ProcessingPackage"
        },
        {
          "$ref": "#/$defs/ReadyPackage"
        }
      ]
    },
    "PackageFigures": {
      "additionalProperties": false,
      "properties": {
        "active_positions_by_month": {
          "description": "Positions per calendar month.",
          "items": {
            "$ref": "#/$defs/MonthPositions"
          },
          "title": "Active Positions By Month",
          "type": "array",
          "x-source": "active_positions_by_month"
        },
        "average_daily_balance_cents": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Days-weighted average daily balance of the validated accounts; null when none is validated or two accounts of one statement would be averaged.",
          "title": "Average Daily Balance Cents",
          "x-source": "totals.average_daily_balance"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "ISO 4217 code of every money figure here; null when refused.",
          "title": "Currency",
          "x-source": "totals.currency"
        },
        "currency_refusal": {
